# Copie este arquivo para .env.local e preencha os valores reais.
# .env.local nunca é commitado (está no .gitignore) — só este .env.example fica no repositório,
# e por isso NUNCA deve ter valores reais, só os nomes das variáveis.

# GoHighLevel / Agenzi — token de "Private Integration" da subconta
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Preenchidos mais à frente, quando o site completo (com banco de dados) começar:
# SUPABASE_ACCESS_TOKEN=          (token pessoal, só p/ criar/gerir o projeto via CLI)
# NEXT_PUBLIC_SUPABASE_URL=       (específico do projeto, gerado depois de criado)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=  (idem — é público por design, protegido pelas regras de RLS)
# SUPABASE_SERVICE_ROLE_KEY=      (server-only, nunca exposto ao navegador)
# DEEPL_API_KEY=
# ADMIN_PASSWORD=                 (gate temporário do /admin — trocar por Supabase Auth na Fase 6)
